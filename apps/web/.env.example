# Sao chép thành .env.local (không commit .env.local)
# Địa chỉ API backend (gồm tiền tố /api/v1). Mặc định khi để trống: http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Đăng nhập Google qua Supabase (tùy chọn). Thiếu một trong hai biến thì ẩn nút "Đăng nhập bằng Google".
# Dùng khóa `anon` (công khai) của project Supabase, TUYỆT ĐỐI không dùng khóa `service_role`.
# Trong Supabase: Authentication > URL Configuration > Redirect URLs thêm <địa chỉ web>/auth/callback.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
