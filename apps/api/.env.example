# Sao chép thành .env (không commit .env)
PORT=3001
DATABASE_URL=postgresql://kiot:kiot_dev_password@localhost:5432/kiot
# Khóa ký access token (JWT), BẮT BUỘC ≥ 32 ký tự, ngẫu nhiên, KHÔNG dùng lại ở môi trường khác.
# Sinh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
WEB_ORIGIN=http://localhost:3000

# ---- Seed (pnpm db:seed) ----
SEED_ADMIN_USERNAME=quanly
# Để trống: hệ thống sinh mật khẩu ngẫu nhiên và ghi vào .seed-admin-credentials.txt (đã bị git bỏ qua).
# Nếu tự đặt: ít nhất 10 ký tự; không dùng mật khẩu thật của bạn ở nơi khác; không commit file .env.
SEED_ADMIN_PASSWORD=
SEED_COMPANY_NAME=

# ---- Xác thực (tùy chọn, có mặc định) ----
# ACCESS_TOKEN_TTL_SECONDS=900   # access token sống 15 phút
# REFRESH_TOKEN_TTL_DAYS=14      # refresh token (cookie httpOnly) sống 14 ngày
# COOKIE_SECURE=true             # mặc định tự bật khi NODE_ENV=production (cần HTTPS)
# LOGIN_MAX_FAILURES=5           # số lần sai tối đa trước khi chặn tạm
# LOGIN_WINDOW_SECONDS=900       # cửa sổ tính lần sai (15 phút)

# ---- Kho file ảnh hàng hóa (chuẩn S3; dev dùng MinIO trong docker-compose) ----
# Dev: `pnpm db:up` rồi `pnpm --filter @kiot/api storage:init` (tạo bucket + cho đọc công khai), bỏ dấu # các dòng dưới.
# Bỏ trống cả nhóm: chạy được nhưng tải ảnh lên sẽ báo lỗi. Production BẮT BUỘC đặt đủ.
# Giá trị dưới đây khớp infra/docker-compose.yml (chỉ dùng cho máy dev).
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=product-images
# S3_ACCESS_KEY=kiot_minio
# S3_SECRET_KEY=kiot_minio_dev_password
# FILE_PUBLIC_BASE_URL=http://localhost:9000/product-images
