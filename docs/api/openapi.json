      "put": {
        "description": "Mọi vai trò trừ Quản lý phải có ít nhất một chi nhánh. Chi nhánh mặc định không còn được gán thì bị bỏ.",
        "operationId": "UsersController_setBranches",
        "parameters": [
          {
            "name": "id",
