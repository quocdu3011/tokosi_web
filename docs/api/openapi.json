                    "temporaryPassword": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Không có quyền `user.manage` (chỉ Quản lý)"
          },
          "404": {
            "description": "Không tìm thấy người dùng"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Đặt lại mật khẩu",
        "tags": [
          "Người dùng"
        ]
      }
    },
