        ],
        "summary": "Đổi mật khẩu",
        "tags": [
          "Xác thực"
        ]
      }
    },
    "/api/v1/users": {
      "get": {
        "operationId": "UsersController_list",
        "parameters": [
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Tìm không dấu theo mã / tên đăng nhập / họ tên / SĐT",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "role",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "manager",
                "assistant",
                "accountant",
                "warehouse",
                "driver",
                "sales",
                "marketing"
              ]
            }
          },
          {
            "name": "isActive",
            "required": false,
            "in": "query",
            "description": "Lọc theo trạng thái hoạt động",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserListDto"
                }
              }
            }
          },
          "403": {
            "description": "Không có quyền `user.manage` (chỉ Quản lý)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Danh sách người dùng (tìm không dấu, lọc, phân trang)",
        "tags": [
          "Người dùng"
        ]
      },
      "post": {
        "description": "Tài khoản mới bị bắt đổi mật khẩu ở lần đăng nhập đầu. Bỏ trống `password` thì hệ thống sinh mật khẩu tạm và trả `temporaryPassword` (chỉ một lần).",
        "operationId": "UsersController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserWithPasswordDto"
                }
              }
            }
          },
          "403": {
            "description": "Không có quyền `user.manage` (chỉ Quản lý)"
          },
          "409": {
            "description": "`DUPLICATE_USERNAME`"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Tạo người dùng",
        "tags": [
          "Người dùng"
        ]
      }
    },
