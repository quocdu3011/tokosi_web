    "/api/v1/users/{id}/reset-password": {
      "post": {
        "description": "Đặt mật khẩu mới, bắt đổi ở lần đăng nhập kế tiếp và thu hồi mọi phiên đang đăng nhập của người đó. Không áp dụng cho chính mình (dùng `POST /auth/change-password`). Bỏ trống `newPassword` thì hệ thống sinh và trả `temporaryPassword` (chỉ một lần).",
        "operationId": "UsersController_resetPassword",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
