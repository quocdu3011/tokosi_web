    "/api/v1/roles/{role}/permissions": {
      "get": {
        "operationId": "RolesController_get",
        "parameters": [
          {
            "name": "role",
            "required": true,
            "in": "path",
            "schema": {
              "enum": [
                "manager",
                "assistant",
                "accountant",
                "warehouse",
                "driver",
                "sales",
                "marketing"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RolePermissionsDto"
                }
              }
            }
          },
          "403": {
            "description": "Không có quyền `role.manage` (chỉ Quản lý)"
          },
          "404": {
            "description": "Vai trò không tồn tại"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Quyền hiện tại của một vai trò",
        "tags": [
          "Phân quyền"
        ]
      },
      "put": {
        "description": "Thay thế toàn bộ bộ quyền cũ. Server tự thêm các quyền bắt buộc đi kèm (trả trong `autoAdded`). Có hiệu lực ngay cho mọi người dùng thuộc vai trò đó, không cần đăng nhập lại.",
        "operationId": "RolesController_set",
        "parameters": [
          {
            "name": "role",
            "required": true,
            "in": "path",
            "schema": {
              "enum": [
                "manager",
                "assistant",
                "accountant",
                "warehouse",
                "driver",
                "sales",
                "marketing"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetRolePermissionsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetRolePermissionsResultDto"
                }
              }
            }
          },
          "403": {
            "description": "Không có quyền `role.manage` (chỉ Quản lý)"
          },
          "409": {
            "description": "`ROLE_LOCKED`: không chỉnh được vai trò Quản lý"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Đặt lại toàn bộ quyền của một vai trò",
        "tags": [
          "Phân quyền"
        ]
      }
    },
    "/api/v1/roles/{role}/permissions/reset": {
