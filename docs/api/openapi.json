        "summary": "Gán chi nhánh cho người dùng (thay thế toàn bộ danh sách)",
        "tags": [
          "Người dùng"
        ]
      }
    }
  },
  "info": {
    "title": "Kiot API",
    "description": "API hệ thống quản lý bán hàng sỉ. Quy ước chung (tiền là chuỗi thập phân, lỗi, phân trang, idempotency): xem docs/api/README.md.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "time": {
            "type": "string",
            "example": "2026-11-03T07:11:16.170Z",
            "description": "Thời gian server (ISO 8601 UTC)"
          }
        },
        "required": [
          "status",
          "time"
        ]
      },
      "PermissionDefDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "invoice.create"
          },
          "label": {
            "type": "string",
            "example": "Xuất hóa đơn"
          },
          "description": {
            "type": "string"
          },
          "scopable": {
            "type": "boolean",
            "description": "Có thể chọn phạm vi \"chỉ của mình\""
          },
          "requires": {
            "description": "Quyền bắt buộc đi kèm (tự được thêm khi lưu)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lockedToAdmin": {
            "type": "boolean",
            "description": "Chỉ vai trò Quản lý có; không thể cấp cho vai trò khác"
          }
        },
        "required": [
          "code",
          "label",
          "scopable",
          "requires",
          "lockedToAdmin"
        ]
      },
      "PermissionModuleDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "sales"
          },
          "label": {
            "type": "string",
            "example": "Đơn hàng"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PermissionDefDto"
            }
          }
        },
        "required": [
          "key",
          "label",
          "permissions"
        ]
      },
      "PermissionCatalogDto": {
        "type": "object",
        "properties": {
          "modules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PermissionModuleDto"
            }
          }
        },
        "required": [
          "modules"
        ]
      },
      "RoleSummaryDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "manager",
              "assistant",
              "accountant",
              "warehouse",
              "driver",
              "sales",
              "marketing"
            ]
          },
          "label": {
            "type": "string",
            "example": "Kế toán"
          },
          "locked": {
            "type": "boolean",
