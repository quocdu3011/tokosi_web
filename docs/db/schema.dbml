Ref: purchase_returns.refund_account_id > cash_accounts.id
Ref: purchase_returns.created_by > users.id
Ref: refresh_tokens.user_id > users.id [delete: cascade]
Ref: role_permissions.updated_by > users.id [delete: set null]
