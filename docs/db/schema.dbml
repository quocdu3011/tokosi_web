Project kiot {
  database_type: 'PostgreSQL'
  Note: '''
    # Kiot — Lược đồ CSDL
    Sinh tự động từ apps/api/src/db/schema (Drizzle). KHÔNG sửa tay — chạy `pnpm db:docs`.

    Quy ước kiểu số: numeric(18,0) = tiền chứng từ (đồng); numeric(18,4) = đơn giá/giá vốn; numeric(14,3) = số lượng.
    Chứng từ không xóa cứng (đổi status). Sổ cái stock_movements và debt_ledger chỉ thêm.
  '''
}

enum cash_account_type {
  "cash"
  "bank"
}

enum cash_direction {
  "in"
  "out"
}

enum customer_type {
  "individual"
  "company"
}

enum doc_status {
  "completed"
  "cancelled"
}

enum import_mode {
  "overwrite"
  "add"
}

enum import_status {
  "queued"
  "running"
  "completed"
  "failed"
}

enum import_type {
  "products"
  "customers"
  "suppliers"
  "price-books"
}

enum ledger_entry_type {
  "opening"
  "invoice"
  "payment"
  "return"
  "adjustment"
  "transfer"
}

enum liquidation_status {
  "normal"
  "clearance"
  "disabled"
  "high_stock"
  "priority_stock"
}

enum order_status {
  "draft"
  "completed"
  "cancelled"
}

enum party_type {
  "customer"
  "supplier"
  "employee"
}

enum payment_method {
  "cash"
  "bank"
}

enum permission_scope {
  "all"
  "own"
}

enum product_type {
  "goods"
  "combo"
}

enum return_settlement {
  "offset_debt"
  "refund"
}

enum shipping_payer {
  "sender"
  "receiver"
}

enum stock_ref_type {
  "opening"
  "goods_receipt"
  "invoice"
  "sales_return"
  "purchase_return"
  "adjustment"
  "transfer_out"
  "transfer_in"
  "transfer_cancel"
}

enum transfer_status {
  "in_transit"
  "received"
  "cancelled"
}

enum user_role {
  "manager"
  "assistant"
  "accountant"
  "warehouse"
  "driver"
  "sales"
  "marketing"
  "pending"
}

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid
  action text [not null]
  entity_type text [not null]
  entity_id uuid
  before jsonb
  after jsonb
  ip text
  request_id text
  branch_id uuid
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (request_id) [name: 'audit_logs_request_idx']
    (entity_type, entity_id) [name: 'audit_logs_entity_idx']
    (created_at) [name: 'audit_logs_created_idx']
  }

  Note: '''Nhật ký thao tác — chỉ thêm, không sửa.'''
}

Table branches {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  name text [not null]
  address text
  phone text
  is_default boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (is_default) [name: 'branches_one_default', unique]
  }

  Note: '''Chi nhánh/kho (Hà Nội, Sài Gòn). Giá bán, tồn kho, giá vốn, công nợ, quỹ và mọi chứng từ đều tách theo chi nhánh.'''
}

Table cash_accounts {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  type cash_account_type [not null]
  branch_id uuid
  opening_balance numeric(18,0) [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''Quỹ: tiền mặt hoặc tài khoản ngân hàng.'''
}

Table cash_categories {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [unique]
  name text [not null]
  direction cash_direction [not null]
  is_system boolean [not null, default: false]
  is_active boolean [not null, default: true]
  sort_order integer [not null, default: 0]

  Note: '''Danh mục thu chi chuẩn.'''
}

Table cash_transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  branch_id uuid [not null]
  direction cash_direction [not null]
  amount numeric(18,0) [not null, note: 'Luôn dương; chiều thu/chi do direction']
  category_id uuid [not null]
  account_id uuid [not null]
  occurred_at timestamptz [not null]
  party_type party_type
  party_id uuid [note: 'Đa hình theo party_type (không có khóa ngoại)']
  party_name text
  vehicle_ref text
  ref_type text
  ref_id uuid
  status doc_status [not null, default: 'completed']
  note text
  created_by uuid
  cancelled_at timestamptz
  cancel_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (occurred_at) [name: 'cash_transactions_time_idx']
    (party_type, party_id) [name: 'cash_transactions_party_idx']
    (account_id, occurred_at) [name: 'cash_transactions_account_idx']
  }

  Note: '''Phiếu thu/chi. amount luôn dương, chiều do direction. party_id đa hình theo party_type.
CHECK cash_transactions_amount_pos: amount > 0'''
}

Table categories {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  parent_id uuid
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (parent_id) [name: 'categories_parent_idx']
    (`coalesce(parentId, '00000000-0000-0000-0000-000000000000'::uuid)`, `f_search_text(name)`) [name: 'categories_sibling_name_unique', unique]
  }

  Note: '''Nhóm hàng dạng cây (parent_id).'''
}

Table code_sequences {
  prefix text [pk]
  next_value bigint [not null, default: 1]
  digits integer [not null, default: 6]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''Bộ đếm sinh mã chứng từ theo tiền tố (HD, DH, PN…).'''
}

Table company_profile {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  address text
  phone text
  email text
  tax_code text
  bank_name text
  bank_account text
  logo_url text
  invoice_note text
  updated_at timestamptz [not null, default: `now()`]

  Note: '''Thông tin công ty (1 dòng) dùng cho mẫu in.'''
}

Table customer_branch_terms {
  customer_id uuid [not null]
  branch_id uuid [not null]
  credit_limit numeric(18,0) [note: 'Hạn mức công nợ tại chi nhánh này (cảnh báo mềm)']
  payment_term_days integer
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (customer_id, branch_id) [pk]
  }

  Note: '''Hạn mức và kỳ hạn công nợ của khách, riêng từng chi nhánh.'''
}

Table customer_invoice_profiles {
  customer_id uuid [pk]
  buyer_name text
  company_name text
  tax_code text
  address text
  email text
  phone text
  bank_name text
  bank_account text

  Note: '''Thông tin xuất hóa đơn VAT/điện tử của khách.'''
}

Table customers {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  name text [not null]
  type customer_type [not null, default: 'individual']
  phone text [unique]
  address text
  facebook text
  sales_owner_id uuid [note: 'Nhân viên phụ trách (ở KiotViet là "Nhóm khách hàng")']
  linked_branch_id uuid [unique, note: 'Khách hàng hệ thống đại diện một chi nhánh (chuyển kho nội bộ)']
  note text
  is_active boolean [not null, default: true]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (`f_search_text(code || ' ' || name || ' ' || coalesce(phone, '')) gin_trgm_ops`) [name: 'customers_search_trgm']
    (sales_owner_id) [name: 'customers_sales_owner_idx']
  }

  Note: '''Khách hàng. Công nợ không lưu ở đây: số dư = tổng debt_ledger (có thể âm). sales_owner_id = nhân viên phụ trách.'''
}

Table debt_ledger {
  id uuid [pk, default: `gen_random_uuid()`]
  branch_id uuid [not null, note: 'Công nợ tách biệt theo chi nhánh']
  party_type party_type [not null]
  party_id uuid [not null, note: 'Đa hình theo party_type (không có khóa ngoại)']
  entry_type ledger_entry_type [not null]
  ref_type text
  ref_id uuid
  ref_code text
  amount numeric(18,0) [not null, note: '+ tăng nợ, − giảm nợ']
  occurred_at timestamptz [not null]
  note text
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    (party_type, party_id, branch_id, occurred_at) [name: 'debt_ledger_party_idx']
    (branch_id, occurred_at) [name: 'debt_ledger_branch_idx']
    (ref_type, ref_id) [name: 'debt_ledger_ref_idx']
  }

  Note: '''Sổ cái công nợ — chỉ thêm. amount có dấu (+ tăng nợ, − giảm nợ). Số dư được phép âm. party_id đa hình nên không có khóa ngoại.
CHECK debt_ledger_nonzero: amount <> 0'''
}

Table goods_receipt_items {
  id uuid [pk, default: `gen_random_uuid()`]
  receipt_id uuid [not null]
  product_id uuid [not null]
  qty numeric(14,3) [not null]
  unit_cost numeric(18,4) [not null]
  line_total numeric(18,0) [not null]
  note text

  indexes {
    (receipt_id) [name: 'goods_receipt_items_receipt_idx']
    (product_id) [name: 'goods_receipt_items_product_idx']
  }

  Note: '''Dòng hàng của phiếu nhập.
CHECK goods_receipt_items_qty_pos: qty > 0'''
}

Table goods_receipts {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  branch_id uuid [not null]
  supplier_id uuid [not null]
  status doc_status [not null, default: 'completed']
  received_at timestamptz [not null]
  supplier_invoice_no text
  po_ref text [note: 'Mã phiếu đặt nhập (PDN…) dạng chữ, chỉ để đối chiếu']
  subtotal numeric(18,0) [not null]
  discount numeric(18,0) [not null, default: 0]
  total numeric(18,0) [not null]
  paid_amount numeric(18,0) [not null, default: 0]
  received_by uuid
  note text
  created_by uuid
  cancelled_at timestamptz
  cancel_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (supplier_id, received_at) [name: 'goods_receipts_supplier_idx']
    (received_at) [name: 'goods_receipts_time_idx']
  }

  Note: '''Phiếu nhập hàng. po_ref chỉ là mã phiếu đặt nhập dạng chữ để đối chiếu.'''
}

Table idempotency_keys {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  key text [not null]
  endpoint text [not null]
  request_hash text [not null]
  response_status integer
  response_body jsonb
  resource_type text
  resource_id uuid
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]

  indexes {
    (user_id, key) [name: 'idempotency_user_key_uq', unique]
    (expires_at) [name: 'idempotency_expires_idx']
  }

  Note: '''Chống tạo trùng khi gửi lại yêu cầu (header Idempotency-Key).'''
}

Table import_jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  type import_type [not null]
  mode import_mode [not null, default: 'overwrite']
  status import_status [not null, default: 'queued']
  dry_run boolean [not null, default: true]
  file_name text
  total integer [not null, default: 0]
  created integer [not null, default: 0]
  updated integer [not null, default: 0]
  failed integer [not null, default: 0]
  errors jsonb
  branch_id uuid
  file_hash text
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  finished_at timestamptz

  indexes {
    (branch_id, file_hash) [name: 'import_jobs_add_file_unique', unique]
  }

  Note: '''Công việc import Excel chạy nền.'''
}

Table invoice_items {
  id uuid [pk, default: `gen_random_uuid()`]
  invoice_id uuid [not null]
  line_no integer [not null]
  product_id uuid [not null]
  product_code text [not null]
  product_name text [not null]
  qty numeric(14,3) [not null]
  list_price numeric(18,4) [not null]
  discount_per_unit numeric(18,4) [not null, default: 0, note: 'Giảm giá tính trên 1 đơn vị (số tiền, không phải %)']
  unit_price numeric(18,4) [not null, note: 'list_price − discount_per_unit']
  line_total numeric(18,0) [not null]
  unit_cost numeric(18,4) [not null, default: 0, note: 'Giá vốn tại thời điểm bán (tính lãi gộp)']
  is_gift boolean [not null, default: false]
  note text

  indexes {
    (invoice_id) [name: 'invoice_items_invoice_idx']
    (product_id) [name: 'invoice_items_product_idx']
  }

  Note: '''Dòng hóa đơn; lưu bản sao mã/tên/đơn vị/giá vốn tại thời điểm bán.
CHECK invoice_items_qty_pos: qty > 0'''
}

Table invoice_payments {
  id uuid [pk, default: `gen_random_uuid()`]
  invoice_id uuid [not null]
  method payment_method [not null]
  account_id uuid [not null]
  amount numeric(18,0) [not null]
  paid_at timestamptz [not null]
  cash_transaction_id uuid

  indexes {
    (invoice_id) [name: 'invoice_payments_invoice_idx']
  }

  Note: '''Khoản thanh toán lúc xuất hóa đơn (tiền mặt/chuyển khoản).
CHECK invoice_payments_amount_pos: amount > 0'''
}

Table invoices {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  root_invoice_id uuid [note: 'Hóa đơn gốc (bản sửa .nn)']
  revision_no integer [not null, default: 0]
  branch_id uuid [not null]
  order_id uuid [unique]
  customer_id uuid [not null]
  seller_id uuid
  invoiced_at timestamptz [not null]
  subtotal numeric(18,0) [not null]
  discount numeric(18,0) [not null, default: 0]
  total numeric(18,0) [not null]
  paid_total numeric(18,0) [not null, default: 0, note: 'Đã thu khi tạo + đã cấn trừ về sau (cache của sổ cái)']
  status doc_status [not null, default: 'completed']
  ship_name text
  ship_phone text
  ship_address text
  note text
  created_by uuid
  cancelled_at timestamptz
  cancel_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (customer_id, invoiced_at) [name: 'invoices_customer_idx']
    (invoiced_at) [name: 'invoices_time_idx']
    (status) [name: 'invoices_status_idx']
    (root_invoice_id, revision_no) [name: 'invoices_root_rev_uq', unique]
  }

  Note: '''Hóa đơn bán. Không sửa sau khi tạo (hủy và tạo lại). root_invoice_id/revision_no dành cho bản sửa .nn.'''
}

Table order_items {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  line_no integer [not null]
  product_id uuid [not null]
  qty numeric(14,3) [not null]
  list_price numeric(18,4) [not null]
  discount_per_unit numeric(18,4) [not null, default: 0, note: 'Giảm giá tính trên 1 đơn vị (số tiền, không phải %)']
  unit_price numeric(18,4) [not null]
  line_total numeric(18,0) [not null]
  is_gift boolean [not null, default: false]
  note text

  indexes {
    (order_id) [name: 'order_items_order_idx']
    (product_id) [name: 'order_items_product_idx']
  }

  Note: '''Dòng hàng của đơn đặt hàng.
CHECK order_items_qty_pos: qty > 0'''
}

Table orders {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  branch_id uuid [not null]
  customer_id uuid [not null]
  status order_status [not null, default: 'draft']
  seller_id uuid
  ordered_at timestamptz [not null]
  subtotal numeric(18,0) [not null, default: 0]
  discount numeric(18,0) [not null, default: 0]
  total numeric(18,0) [not null, default: 0]
  deposit_amount numeric(18,0) [not null, default: 0, note: 'Tiền đặt cọc đã thu']
  ship_name text
  ship_phone text
  ship_address text
  package_count integer
  weight_g numeric(12,2)
  note text
  created_by uuid
  cancelled_at timestamptz
  cancel_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (customer_id, ordered_at) [name: 'orders_customer_idx']
    (status) [name: 'orders_status_idx']
  }

  Note: '''Đặt hàng. draft = phiếu tạm giữ hàng; một đơn → tối đa một hóa đơn.'''
}

Table payment_allocations {
  id uuid [pk, default: `gen_random_uuid()`]
  cash_transaction_id uuid [not null]
  invoice_id uuid [not null]
  amount numeric(18,0) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (cash_transaction_id, invoice_id) [name: 'payment_allocations_uq', unique]
    (invoice_id) [name: 'payment_allocations_invoice_idx']
  }

  Note: '''Cấn trừ phiếu thu vào từng hóa đơn.
CHECK payment_allocations_amount_pos: amount > 0'''
}

Table product_components {
  combo_id uuid [not null]
  component_id uuid [not null]
  qty integer [not null]
  sort_order integer [not null, default: 0]

  indexes {
    (combo_id, component_id) [pk]
    (component_id) [name: 'product_components_component_idx']
  }

  Note: '''Thành phần của combo: combo_id → component_id (hàng hóa) với qty nguyên dương. Combo không có tồn/giá vốn riêng, luôn tính từ thành phần.
CHECK product_components_qty_positive: qty > 0
CHECK product_components_not_self: comboId <> componentId'''
}

Table product_images {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  url text [not null]
  storage_key text
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (product_id) [name: 'product_images_product_idx']
  }

  Note: '''Ảnh sản phẩm.'''
}

Table products {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  name text [not null]
  category_id uuid
  product_type product_type [not null, default: 'goods', note: 'Loại hàng: goods = Hàng hóa (mặc định), combo = gói các hàng thành phần (không có tồn/giá vốn riêng)']
  liquidation_status liquidation_status [not null, default: 'normal', note: 'Trạng thái thanh lý: normal = Thường (mặc định), clearance = Thanh Lý, disabled = Tắt Mã, high_stock = Tồn Cao, priority_stock = Tồn Ưu Tiên']
  description text
  is_active boolean [not null, default: true]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (category_id) [name: 'products_category_idx']
    (`f_search_text(code || ' ' || name) gin_trgm_ops`) [name: 'products_search_trgm']
    (is_active) [name: 'products_active_idx']
    (product_type) [name: 'products_type_idx']
    (liquidation_status) [name: 'products_liquidation_idx']
    (`lower(code)`) [name: 'products_code_lower_unique', unique]
  }

  Note: '''Hàng hóa — chỉ thông tin DÙNG CHUNG giữa các chi nhánh. Giá bán ở price_book_items, tồn kho/giá vốn/vị trí ở stocks (theo chi nhánh).'''
}

Table purchase_return_items {
  id uuid [pk, default: `gen_random_uuid()`]
  return_id uuid [not null]
  product_id uuid [not null]
  qty numeric(14,3) [not null]
  return_price numeric(18,4) [not null]
  line_total numeric(18,0) [not null]

  indexes {
    (return_id) [name: 'purchase_return_items_return_idx']
  }

  Note: '''Dòng hàng của phiếu trả nhập.
CHECK purchase_return_items_qty_pos: qty > 0'''
}

Table purchase_returns {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  branch_id uuid [not null]
  supplier_id uuid [not null]
  goods_receipt_id uuid
  status doc_status [not null, default: 'completed']
  returned_at timestamptz [not null]
  total numeric(18,0) [not null]
  settlement return_settlement [not null, default: 'offset_debt']
  refund_account_id uuid
  reason text
  note text
  created_by uuid
  cancelled_at timestamptz
  cancel_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (supplier_id, returned_at) [name: 'purchase_returns_supplier_idx']
  }

  Note: '''Trả hàng nhập (trả lại nhà cung cấp).'''
}

Table refresh_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  token_hash text [not null, unique]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  revoke_reason text
  user_agent text
  ip text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id) [name: 'refresh_tokens_user_idx']
  }

  Note: '''Refresh token (lưu băm, không lưu token thô).'''
}

Table role_permissions {
  role user_role [not null]
  permission_code text [not null]
  scope permission_scope [not null, default: 'all']
  updated_by uuid
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (role, permission_code) [pk]
    (role) [name: 'role_permissions_role_idx']
  }

  Note: '''Quyền của từng vai trò do Quản lý cấu hình (vai trò manager luôn đủ quyền, không lưu ở đây).'''
}

Table sales_return_items {
  id uuid [pk, default: `gen_random_uuid()`]
  return_id uuid [not null]
  product_id uuid [not null]
  qty numeric(14,3) [not null]
  return_price numeric(18,4) [not null]
  line_total numeric(18,0) [not null]
  restock boolean [not null, default: true, note: 'true = nhập lại kho']
  restock_cost numeric(18,4)
  reason text

  indexes {
    (return_id) [name: 'sales_return_items_return_idx']
  }

  Note: '''Dòng hàng trả lại của khách.
CHECK sales_return_items_qty_pos: qty > 0'''
}

Table sales_returns {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  branch_id uuid [not null]
  customer_id uuid [not null]
  invoice_id uuid
  status doc_status [not null, default: 'completed']
  returned_at timestamptz [not null]
  total numeric(18,0) [not null]
  settlement return_settlement [not null, default: 'offset_debt']
  refund_account_id uuid
  received_by uuid
  note text
  created_by uuid
  cancelled_at timestamptz
  cancel_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (customer_id, returned_at) [name: 'sales_returns_customer_idx']
    (invoice_id) [name: 'sales_returns_invoice_idx']
  }

  Note: '''Trả hàng bán. Có thể không tham chiếu hóa đơn; mặc định bù trừ công nợ.'''
}

Table stock_movements {
  id uuid [pk, default: `gen_random_uuid()`]
  branch_id uuid [not null]
  product_id uuid [not null]
  qty_delta numeric(14,3) [not null, note: 'Số lượng thay đổi: + nhập, − xuất']
  unit_cost numeric(18,4)
  ref_type stock_ref_type [not null]
  ref_id uuid
  ref_code text
  occurred_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    (product_id, occurred_at) [name: 'stock_movements_product_time_idx']
    (ref_type, ref_id) [name: 'stock_movements_ref_idx']
  }

  Note: '''Sổ cái kho — chỉ thêm. Phục vụ thẻ kho.
CHECK stock_movements_nonzero: qtyDelta <> 0'''
}

Table stock_transfer_items {
  id uuid [pk, default: `gen_random_uuid()`]
  transfer_id uuid [not null]
  product_id uuid [not null]
  qty numeric(14,3) [not null]
  unit_cost_sent numeric(18,4) [not null]
  shipping_share numeric(18,0) [not null, default: 0]
  unit_cost_received numeric(18,4) [note: 'Giá nhập kho bên nhận = giá vốn gửi + phí phân bổ / số lượng']

  indexes {
    (transfer_id) [name: 'stock_transfer_items_transfer_idx']
    (product_id) [name: 'stock_transfer_items_product_idx']
  }

  Note: '''Dòng hàng chuyển kho: giá vốn bên gửi, phần phí phân bổ và giá nhập kho của bên nhận.
CHECK stock_transfer_items_qty_pos: qty > 0'''
}

Table stock_transfers {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  from_branch_id uuid [not null]
  to_branch_id uuid [not null]
  status transfer_status [not null, default: 'in_transit']
  sent_at timestamptz [not null]
  received_at timestamptz
  goods_value numeric(18,0) [not null, note: 'Tổng tiền hàng theo giá vốn bên gửi tại thời điểm gửi']
  shipping_fee numeric(18,0) [not null, default: 0, note: 'Phí vận chuyển; cộng vào giá nhập kho của bên nhận']
  shipping_paid_by shipping_payer [not null, default: 'sender', note: 'Bên ứng tiền trả xe; sender → công nợ đối ứng gồm cả phí']
  debt_amount numeric(18,0) [note: 'Công nợ đối ứng đã ghi khi nhận hàng']
  note text
  created_by uuid
  received_by uuid
  cancelled_at timestamptz
  cancel_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (from_branch_id, sent_at) [name: 'stock_transfers_from_idx']
    (to_branch_id, sent_at) [name: 'stock_transfers_to_idx']
    (status) [name: 'stock_transfers_status_idx']
  }

  Note: '''Phiếu chuyển kho giữa 2 chi nhánh, 2 bước (đang đi đường → đã nhận). Không phải hóa đơn bán. Giá nhập bên nhận = giá vốn bên gửi + phí vận chuyển phân bổ.
CHECK stock_transfers_branches_differ: fromBranchId <> toBranchId
CHECK stock_transfers_fee_nonneg: shippingFee >= 0'''
}

Table stocks {
  branch_id uuid [not null]
  product_id uuid [not null]
  on_hand numeric(14,3) [not null, default: 0, note: 'Tồn thực tế; không âm (CHECK)']
  cost_price numeric(18,4) [not null, default: 0, note: 'Giá vốn bình quân gia quyền CỦA chi nhánh này']
  last_purchase_price numeric(18,4) [note: 'Giá nhập cuối của chi nhánh này']
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (branch_id, product_id) [pk]
  }

  Note: '''Kho theo (chi nhánh, sản phẩm): tồn, giá vốn bình quân, giá nhập cuối, tồn tối thiểu/tối đa, vị trí kho. Chỉ cập nhật cùng transaction với stock_movements.
CHECK stocks_on_hand_nonneg: onHand >= 0'''
}

Table supplier_branch_history {
  supplier_id uuid [not null]
  branch_id uuid [not null]
  purchase_total numeric(18,0) [not null, default: 0]
  purchase_net numeric(18,0) [not null, default: 0]

  indexes {
    (supplier_id, branch_id) [pk]
  }
}

Table suppliers {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  name text [not null]
  group_name text
  linked_branch_id uuid [unique, note: 'Nhà cung cấp hệ thống đại diện một chi nhánh (chuyển kho nội bộ)']
  is_active boolean [not null, default: true]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (`f_search_text(code || ' ' || name || ' ' || coalesce(groupName, '')) gin_trgm_ops`) [name: 'suppliers_search_trgm']
    (`lower(code)`) [name: 'suppliers_code_lower_unique', unique]
  }

  Note: '''Nhà cung cấp; kind phân biệt NCC hàng hóa với lái xe/đối tượng khác; group_name là nhóm NCC (chuỗi tự do, có thể để trống).'''
}

Table system_settings {
  key text [pk]
  value jsonb [not null]
  updated_by uuid
  updated_at timestamptz [not null, default: `now()`]

  Note: '''Cài đặt hệ thống dạng khóa → JSON do Quản lý chỉnh (vd mở/tắt tự đăng ký bằng Google).'''
}

Table user_branches {
  user_id uuid [not null]
  branch_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, branch_id) [pk]
    (branch_id) [name: 'user_branches_branch_idx']
  }

  Note: '''Chi nhánh người dùng được làm việc (Quản lý thấy tất cả, không cần dòng ở đây).'''
}

Table user_identities {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  provider text [not null]
  provider_subject text [not null]
  email text [not null]
  linked_at timestamptz [not null, default: `now()`]

  indexes {
    (provider, provider_subject) [name: 'user_identities_provider_subject_unique', unique]
    (user_id) [name: 'user_identities_user_idx']
  }

  Note: '''Danh tính đăng nhập bên ngoài (Google qua Supabase) gắn với người dùng; khớp theo provider_subject, không theo email.'''
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  username text [not null, unique]
  full_name text [not null]
  password_hash text [not null]
  must_change_password boolean [not null, default: false]
  role user_role [not null]
  phone text
  default_branch_id uuid
  is_active boolean [not null, default: true]
  last_login_at timestamptz
  password_changed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (role) [name: 'users_role_idx']
    (`lower(username)`) [name: 'users_username_lower_unique', unique]
  }

  Note: '''Người dùng đăng nhập. Vai trò cố định (enum user_role).'''
}

